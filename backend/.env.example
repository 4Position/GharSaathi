# PostgreSQL connection string. Do not commit your real credentials.
DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/gharsaathi_dev?schema=public"

# HTTP port for the Express API
PORT=5001

# Frontend origin allowed by CORS
CLIENT_URL="http://localhost:5173"

# JWT settings for authenticated API requests. Use a long, random secret locally.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
